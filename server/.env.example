NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL — use a full connection string OR individual parts
DATABASE_URL=postgres://user:password@localhost:5432/culturemetrics_dev

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_long_random_string
JWT_SECRET=replace_with_another_long_random_string
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Admin bootstrap — used ONCE by: npm run bootstrap:admin
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@culturemetrics.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe_Str0ng!

# CultureFrame integration
CULTUREFRAME_API_URL=https://jennycultureframe-1.onrender.com
CULTUREFRAME_API_TOKEN=
CULTUREFRAME_API_TIMEOUT_MS=15000
CULTUREFRAME_INTEGRATION_ENABLED=false

# Data mode: "mock" | "live" | "snapshot"
CULTUREMETRICS_DATA_MODE=mock
